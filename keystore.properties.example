# Copy to keystore.properties (git-ignored) to sign release builds.
# Create the upload key once and back it up outside the repository:
#   keytool -genkeypair -v -keystore %USERPROFILE%\.android\memetype-upload.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000
# Google Play App Signing keeps the app signing key; this upload key only signs what you upload.
storeFile=C\:/Users/Urim/.android/memetype-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
