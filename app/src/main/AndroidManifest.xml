<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online template sources: Imgflip and memegen.link (index + images, https only). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 9 only: saving into Pictures needs it there. Inert on 10+ (MediaStore / SAF). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Lets the app resolve a browser for the GitHub and donate links on API 30+. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Memetype">

        <!-- Onboarding: enable + select the keyboard. Also the launcher entry. -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Donate popup opened from the panel top bar. -->
        <activity
            android:name=".DonateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Memetype.Dialog" />

        <!-- Manage template sources; import packs and images. -->
        <activity
            android:name=".SourcesActivity"
            android:exported="false"
            android:label="@string/sources_title" />

        <!-- Place text boxes on an imported image. -->
        <activity
            android:name=".ImportImageActivity"
            android:exported="false"
            android:label="@string/import_title" />

        <!-- Credentials for a source that supports signing in (Imgflip). -->
        <activity
            android:name=".SourceLoginActivity"
            android:exported="false"
            android:label="@string/auth_sign_in" />

        <!-- The IME itself. -->
        <service
            android:name=".MemeInputMethodService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!-- Exposes rendered memes in cacheDir/memes to the target app. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
