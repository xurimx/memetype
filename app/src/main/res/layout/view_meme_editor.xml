<?xml version="1.0" encoding="utf-8"?>
<!-- Portrait editor: toolbar, canvas, box chips, hint, mini keyboard. layout-land has the same ids. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            style="@style/PanelIconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_arrow_back" />

        <ImageView
            android:id="@+id/btn_add_box"
            style="@style/PanelIconButton"
            android:contentDescription="@string/add_box"
            android:src="@drawable/ic_add_box" />

        <ImageView
            android:id="@+id/btn_delete_box"
            style="@style/PanelIconButton"
            android:contentDescription="@string/delete_box"
            android:src="@drawable/ic_delete" />

        <ImageView
            android:id="@+id/btn_reset_layout"
            style="@style/PanelIconButton"
            android:contentDescription="@string/reset_layout"
            android:src="@drawable/ic_reset" />

        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginEnd="6dp">

            <ImageView
                android:id="@+id/btn_history"
                style="@style/PanelIconButton"
                android:layout_marginEnd="0dp"
                android:contentDescription="@string/history"
                android:src="@drawable/ic_history" />

            <TextView
                android:id="@+id/history_badge"
                android:layout_width="wrap_content"
                android:layout_height="16dp"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="16dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:textColor="@android:color/white"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btn_save"
            style="@style/PanelIconButton"
            android:contentDescription="@string/save"
            android:src="@drawable/ic_save" />

        <TextView
            android:id="@+id/btn_send"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:background="@drawable/bg_send_button"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/send"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <com.umo.memetype.ui.MemeCanvasView
        android:id="@+id/canvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="6dp"
        android:layout_weight="1"
        android:background="@color/panel_surface" />

    <FrameLayout
        android:id="@+id/history_strip"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:visibility="gone" />

    <HorizontalScrollView
        android:id="@+id/box_chips_scroll"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/box_chips"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/send_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="2dp"
        android:text="@string/send_hint_clipboard"
        android:textColor="@color/text_secondary"
        android:textSize="10sp"
        android:visibility="gone" />

    <com.umo.memetype.ui.MiniKeyboardView
        android:id="@+id/keyboard"
        android:layout_width="match_parent"
        android:layout_height="168dp" />
</LinearLayout>
