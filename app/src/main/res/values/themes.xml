<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Memetype" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 34dp round icon button used in the panel toolbars. -->
    <style name="PanelIconButton">
        <item name="android:layout_width">34dp</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text_primary</item>
    </style>

    <style name="Theme.Memetype.Dialog" parent="android:Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
